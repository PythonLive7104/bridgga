# The application's configuration. Copy to backend/.env.
#
# This one file is read by every process -- web, Celery worker, beat, and
# management commands -- because the settings module loads it, not manage.py.
# It is also the file to put on a server: nothing else carries application
# config. infra/.env is separate and configures the local Docker stack only
# (ports, the database container's own credentials).
#
# A variable already present in the real environment always wins over this
# file, so a process manager or a secrets store on the server can override any
# line here without editing it.
#
# Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-locally
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
ADMIN_URL_PREFIX=admin

# Frontend origin: drives CORS, CSRF and the links in account emails.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Database -------------------------------------------------------------- #
# One URL drives everything. Which line you want depends on where the process
# is running, because the hostname differs by vantage point:
#
#   unset              SQLite file. Runs with no containers at all; a local
#                      convenience only, and never what CI or production use
#                      (docs/adr/0006-sqlite-dev-fallback.md).
#
#   localhost:5432     Postgres in the Docker stack, reached from a process on
#                      your machine -- `manage.py runserver` outside Docker.
#
#   db:5432            the same Postgres, reached from inside the stack. This
#                      is what docker-compose.yml sets for its own containers,
#                      and it overrides this file, so you need not set it.
#
# On a server, set the real one here:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Managed Postgres usually requires TLS; the setting below is read in prod.
# DATABASE_SSL_REQUIRE=true
#
# DATABASE_URL=postgresql://bridgga:bridgga@localhost:5432/bridgga

# --- Redis ----------------------------------------------------------------- #
# Broker, cache and Celery result backend. Leave unset to run Celery eagerly
# in-process and cache in memory -- fine for a single developer, wrong
# everywhere else, because nothing then exercises the queues.
# Same hostname rule as above: `localhost` from your machine, `redis` inside
# the stack, the real host on a server.
# REDIS_URL=redis://localhost:6379/0

# Throttling
THROTTLE_BURST=60/min
THROTTLE_SUSTAINED=2000/day

# --- Accounts -------------------------------------------------------------- #
# Confirmation is required before sign-in, as in production. Set to `optional`
# while no mail provider is live, so a new account works immediately.
# `python manage.py verify_email <address>` confirms an existing one.
# ACCOUNT_EMAIL_VERIFICATION=optional

# --- Email (Resend) -------------------------------------------------------- #
# Resend speaks SMTP, so it needs no library and no code of its own: the
# username is the literal string "resend" and the password is the API key.
#
# EMAIL_HOST is the switch. While it is unset, mail goes to the console, or to
# MailHog (http://localhost:8025) under the Docker stack, which sets its own.
# Uncomment both lines below once the sending domain is verified in Resend --
# uncommenting EMAIL_HOST without a working key stops verification mail
# leaving at all, and signup then appears to hang with nothing in the logs.
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_PASSWORD=re_your_api_key_here

EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_USE_TLS=true

# The From address. Must be on a domain verified in Resend, or it is rejected.
DEFAULT_FROM_EMAIL=no-reply@localhost

# MFA issuer shown in authenticator apps
MFA_TOTP_ISSUER=Bridgga

# OAuth. Blank is fine until the provider apps exist; the buttons stay hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- File storage ---------------------------------------------------------- #
# Uploads and exports. Development uses the local filesystem; production uses
# S3 or anything that speaks it. The compose stack sets these itself to reach
# its own SeaweedFS, so leave them alone unless deploying.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3-compatible but not Amazon (SeaweedFS, Backblaze, DigitalOcean Spaces):
# AWS_S3_ENDPOINT_URL=

# --- Payments (Bachs) ------------------------------------------------------ #
# Phase 4. A subscription can already record Bachs as its provider; there is
# no checkout or webhook handler yet, so these are declared and unused.
# The webhook secret is listed now because signature verification is not
# optional -- PRD section 108 names webhook spoofing explicitly.
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_API_BASE_URL=

# --- Error reporting ------------------------------------------------------- #
# Unset means Sentry is simply not initialised. Prospect and conversation data
# is customer PII, so request bodies are never sent (PRD section 62).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# AI provider (Phase 2)
# ============================================================================
# Pick ONE provider by setting its key. AI_PROVIDER is optional: with it blank
# the backend auto-detects from whichever key is present, preferring Anthropic
# if both are set.
#
# With NO key set, the backend runs a deterministic stub provider. The whole
# stack works without credentials, and no test can accidentally spend money.

# --- Option A: OpenAI -------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_PROVIDER=openai

# --- Option B: Anthropic ----------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic

# --- Model routing (optional) ----------------------------------------------
# Cheap models do classification and extraction; advanced models do research
# and strategy. Leave blank to use the defaults for the active provider.
#
#            OpenAI default   price in/out per 1M     Anthropic default
#   cheap    gpt-5-nano       $0.05 / $0.40           claude-haiku-4-5
#   standard gpt-5-mini       $0.25 / $2.00           claude-sonnet-5-5
#   advanced gpt-5.2          $1.75 / $14.00          claude-opus-5-5
#
# Other catalogued OpenAI models: gpt-5.4-nano, gpt-5.4-mini, gpt-5,
# gpt-6-astra ($10/$50 -- far more capable, far dearer).
# AI_MODEL_CHEAP=
# AI_MODEL_STANDARD=
# AI_MODEL_ADVANCED=
