# Copy to backend/.env for local development. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-locally
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
ADMIN_URL_PREFIX=admin

# Frontend origin: drives CORS, CSRF and the links in account emails.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Postgres via infra/docker-compose.yml. Leave unset to fall back to SQLite,
# which is a convenience for running without Docker -- CI always uses Postgres.
# DATABASE_URL=postgres://bridgga:bridgga@localhost:5432/bridgga

# Leave unset to run Celery eagerly in-process and cache in memory.
# REDIS_URL=redis://localhost:6379/0

# Throttling
THROTTLE_BURST=60/min
THROTTLE_SUSTAINED=2000/day

# Email: the dev default prints to the console.
DEFAULT_FROM_EMAIL=no-reply@localhost

# MFA issuer shown in authenticator apps
MFA_TOTP_ISSUER=Bridgga

# OAuth. Blank is fine until the provider apps exist; the buttons stay hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- Production only ---
# DATABASE_SSL_REQUIRE=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-1
# AWS_S3_ENDPOINT_URL=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# ============================================================================
# AI provider (Phase 2)
# ============================================================================
# Pick ONE provider by setting its key. AI_PROVIDER is optional: with it blank
# the backend auto-detects from whichever key is present, preferring Anthropic
# if both are set.
#
# With NO key set, the backend runs a deterministic stub provider. The whole
# stack works without credentials, and no test can accidentally spend money.

# --- Option A: OpenAI -------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_PROVIDER=openai

# --- Option B: Anthropic ----------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic

# --- Model routing (optional) ----------------------------------------------
# Cheap models do classification and extraction; advanced models do research
# and strategy. Leave blank to use the defaults for the active provider.
#
#            OpenAI default   price in/out per 1M     Anthropic default
#   cheap    gpt-5-nano       $0.05 / $0.40           claude-haiku-4-5
#   standard gpt-5-mini       $0.25 / $2.00           claude-sonnet-5-5
#   advanced gpt-5.2          $1.75 / $14.00          claude-opus-5-5
#
# Other catalogued OpenAI models: gpt-5.4-nano, gpt-5.4-mini, gpt-5,
# gpt-6-astra ($10/$50 -- far more capable, far dearer).
# AI_MODEL_CHEAP=
# AI_MODEL_STANDARD=
# AI_MODEL_ADVANCED=

# ============================================================================
# Email delivery (Resend)
# ============================================================================
# Resend exposes SMTP, so it needs no library and no code path of its own: the
# existing EMAIL_* settings point at it. The username is the literal string
# "resend"; the password is the API key.
#
# Transactional account mail (verification, reset, invitations) goes through
# this. Campaign sending is a separate concern with its own per-mailbox rate
# limits and warmup, and arrives in Phase 3.
#
# Development leaves these unset: the console backend prints mail, and
# infra/docker-compose.yml routes it to MailHog on http://localhost:8025.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=no-reply@yourdomain

# ============================================================================
# Payments (Bachs -- https://app.bachs.io/)
# ============================================================================
# Phase 4. The models can already record a Bachs subscription; there is no
# checkout, webhook handler or provider client yet, so these are declared
# here and unused until that work lands.
#
# Webhooks must be signature-verified before they are trusted (PRD section
# 108 lists webhook spoofing explicitly), which is what the secret is for.
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_API_BASE_URL=
