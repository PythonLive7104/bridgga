# Copy to backend/.env for local development. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-locally
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
ADMIN_URL_PREFIX=admin

# Frontend origin: drives CORS, CSRF and the links in account emails.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Postgres via infra/docker-compose.yml. Leave unset to fall back to SQLite,
# which is a convenience for running without Docker -- CI always uses Postgres.
# DATABASE_URL=postgres://palatial:palatial@localhost:5432/palatial

# Leave unset to run Celery eagerly in-process and cache in memory.
# REDIS_URL=redis://localhost:6379/0

# Throttling
THROTTLE_BURST=60/min
THROTTLE_SUSTAINED=2000/day

# Email: the dev default prints to the console.
DEFAULT_FROM_EMAIL=no-reply@localhost

# MFA issuer shown in authenticator apps
MFA_TOTP_ISSUER=Palatial

# OAuth. Blank is fine until the provider apps exist; the buttons stay hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- Production only ---
# DATABASE_SSL_REQUIRE=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-1
# AWS_S3_ENDPOINT_URL=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- AI (Phase 2) ---
# Leave ANTHROPIC_API_KEY unset to run against the deterministic stub provider:
# the whole stack works locally and in CI without credentials, and no test can
# accidentally spend money.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=            # blank auto-detects; or "anthropic" / "stub"

# Per-tier model routing overrides. Blank uses the defaults:
#   cheap    -> claude-haiku-4-5    (classification, extraction)
#   standard -> claude-sonnet-5-5   (drafting, personalisation)
#   advanced -> claude-opus-5-5     (research, strategy, scoring rationale)
# AI_MODEL_CHEAP=
# AI_MODEL_STANDARD=
# AI_MODEL_ADVANCED=
