# Copy to infra/.env to override the development defaults in
# docker-compose.yml. The file is gitignored and read automatically, so it is
# where any real credential belongs -- never in the compose file itself.
#
# Every value here has a working default in docker-compose.yml; this file is
# only for the ones you want to change.

# --- Postgres -------------------------------------------------------------- #
# The compose service is named `db`, and DATABASE_URL is assembled from these:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=bridgga
POSTGRES_PASSWORD=bridgga
POSTGRES_DB=bridgga
# Change if something already has 5432 on the host.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Django ---------------------------------------------------------------- #
DJANGO_SECRET_KEY=docker-dev-secret-not-for-production

# --- Storage (SeaweedFS locally) ------------------------------------------- #
S3_ACCESS_KEY=bridgga
S3_SECRET_KEY=bridgga-dev-secret
AWS_STORAGE_BUCKET_NAME=bridgga-dev

# --- Everything else lives in backend/.env --------------------------------- #
# This file configures the *stack*: which ports, which database credentials,
# what the compose services are called. Application settings -- AI keys, mail,
# verification policy -- belong in backend/.env, which the Django settings
# module loads for every process (web, worker, beat) and which is the single
# file to copy to a server.
#
# Keep them out of here. A variable named in docker-compose.yml is injected
# into the container even when it is empty, and an empty value still counts as
# "set", so it silently shadows the real one in backend/.env.
