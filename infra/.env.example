# Copy to infra/.env to override the development defaults in
# docker-compose.yml. The file is gitignored and read automatically, so it is
# where any real credential belongs -- never in the compose file itself.
#
# Every value here has a working default in docker-compose.yml; this file is
# only for the ones you want to change.

# --- Postgres -------------------------------------------------------------- #
# The compose service is named `db`, and DATABASE_URL is assembled from these:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=bridgga
POSTGRES_PASSWORD=bridgga
POSTGRES_DB=bridgga
# Change if something already has 5432 on the host.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Django ---------------------------------------------------------------- #
DJANGO_SECRET_KEY=docker-dev-secret-not-for-production

# --- Storage (SeaweedFS locally) ------------------------------------------- #
S3_ACCESS_KEY=bridgga
S3_SECRET_KEY=bridgga-dev-secret
AWS_STORAGE_BUCKET_NAME=bridgga-dev

# --- AI providers ---------------------------------------------------------- #
# `stub` returns schema-valid placeholders and costs nothing, which is what
# the test suite and CI use. Switch to anthropic or openai and supply the
# matching key to run real completions.
AI_PROVIDER=stub
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Email ----------------------------------------------------------------- #
# Local development sends to MailHog (http://localhost:8025) and these are
# ignored. Set them to send through Resend from a container -- useful for
# checking how a real verification mail renders.
#
# Resend speaks SMTP, so it needs no library: the username is the literal
# string "resend" and the password is the API key.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_your_api_key
# DEFAULT_FROM_EMAIL=no-reply@yourdomain
